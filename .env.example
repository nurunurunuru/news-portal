# https://aistudio.google.com/apikey theke free key nin
# --- AI POOL (ekta fail korle auto porerta) ---
# Ekadhik Gemini key comma diye din (alada alada Google account/project theke nile quota alada)
GEMINI_API_KEYS=key1,key2,key3
# Model priority order (age ta age try hobe). AI Studio te je model free ache segulo din
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
# OPTIONAL extra free fallback (Gemini shesh hole eigulo kaj korbe)
GROQ_API_KEYS=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
OPENROUTER_API_KEYS=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
# true dile shob AI shesh hole o headline+snippet diye "সংক্ষেপে" post jabe (site khali thakbe na)
RAW_FALLBACK=false
ADMIN_KEY=change-this-secret
PORT=3000
SITE_NAME=Khobor AI
SITE_URL=http://localhost:3000
# koto minute por por news collect hobe
FETCH_EVERY_MINUTES=30
# ek run e max koyta news process hobe (free quota bachate)
MAX_PER_RUN=8
# gemini free limit: ~10 req/min, tai 7 sec gap
GEMINI_DELAY_MS=7000
# true = AI sheshe sheshe auto publish, false = draft hishabe jabe (admin approve korbe)
AUTO_PUBLISH=true
